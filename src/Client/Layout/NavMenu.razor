@implements IDisposable
@inject ClientAuthService Auth
@inject NavigationManager Nav

<header class="site-header">
    <div class="container-width header-inner">
        <a class="brand" href="" aria-label="@(L["Mark's Baseball Cards home"])"><span class="brand-mark"><Icon Name="baseball" Size="30" /></span><span>mark’s<span class="brand-subtitle">BASEBALL CARDS</span></span></a>
        <nav id="site-navigation" class="site-navigation @(_open ? "is-open" : "")" aria-label="@(L["Main navigation"])">
            <NavLink href="" Match="NavLinkMatch.All">@L["Home"]</NavLink>
            <NavLink href="collection">@L["The collection"]</NavLink>
            <NavLink href="marketplace">@L["Marketplace"]</NavLink>
            <NavLink href="about">@L["Our story"]</NavLink>
            <AuthorizeView Roles="@Roles.Admin"><NavLink href="admin">@L["Manage cards"]</NavLink></AuthorizeView>
            <AuthorizeView Roles="@Roles.SystemAdmin"><NavLink href="system">@L["Dashboard"]</NavLink></AuthorizeView>
            <AuthorizeView>
                <Authorized><button class="nav-account" @onclick="LogoutAsync"><Icon Name="lock" Size="15" /> @L["Sign out"]</button></Authorized>
                <NotAuthorized><NavLink class="nav-account" href="login"><Icon Name="lock" Size="15" /> @L["Staff access"]</NavLink></NotAuthorized>
            </AuthorizeView>
        </nav>
        <DisplayPreferences />
        <button class="icon-button mobile-menu-button" aria-label="@L[_open ? "Close navigation" : "Open navigation"]" aria-expanded="@_open.ToString().ToLowerInvariant()" aria-controls="site-navigation" @onclick="() => _open = !_open"><Icon Name="@(_open ? "close" : "menu")" Size="24" /></button>
    </div>
</header>

@code {
    private bool _open;
    protected override void OnInitialized() { base.OnInitialized(); Nav.LocationChanged += CloseNavigation; }
    private void CloseNavigation(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() => { _open = false; StateHasChanged(); });
    private async Task LogoutAsync() { await Auth.LogoutAsync(); Nav.NavigateTo(""); }
    public override void Dispose() { Nav.LocationChanged -= CloseNavigation; base.Dispose(); }
}
