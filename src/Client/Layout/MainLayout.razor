@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="marketplace">Marketplace</a>
        </div>

        <article class="content px-4">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="container py-5 text-center">
                        <div class="display-4">⚠️</div>
                        <h1 class="h4">Something went wrong on this page</h1>
                        <p class="text-muted">An unexpected error occurred while displaying this content.</p>
                        <button class="btn btn-primary" @onclick="Recover">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    // Clear any captured error whenever the user navigates to a new page.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();
}
