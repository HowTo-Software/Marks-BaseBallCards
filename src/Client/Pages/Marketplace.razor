@page "/marketplace"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Marketplace</PageTitle>

<h1>Marketplace</h1>
<p class="text-muted">1991 Topps cards available to buy. Checkout is handled securely by Stripe.</p>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <input class="form-control" style="max-width: 320px" placeholder="Search player or card #"
           @bind="_search" @bind:event="oninput" />
    <div class="form-check ms-2">
        <input class="form-check-input" type="checkbox" id="incSold"
               @bind="_includeSold" @bind:after="LoadAsync" />
        <label class="form-check-label" for="incSold">Show sold</label>
    </div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else if (Filtered.Count == 0)
{
    <div class="alert alert-info">No cards match your search.</div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Filtered)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm @(c.IsSold ? "border-secondary opacity-75" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-1">@c.PlayerName</h5>
                            <span class="badge bg-light text-dark">#@c.CardNumber</span>
                        </div>
                        <div class="mb-2">
                            @if (c.IsRookie)
                            {
                                <span class="badge bg-warning text-dark me-1">Rookie</span>
                            }
                            @if (c.IsRoyals)
                            {
                                <span class="badge bg-info text-dark me-1">Royals</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(c.Condition))
                            {
                                <span class="badge bg-secondary">@c.Condition</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.ListingNotes))
                        {
                            <p class="small text-muted">@c.ListingNotes</p>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                            <span class="h5 mb-0">@(c.Price?.ToString("C") ?? "—")</span>
                            @if (c.IsSold)
                            {
                                <span class="badge bg-secondary">Sold</span>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm" disabled="@(_buyingId == c.Id)"
                                        @onclick="() => BuyAsync(c)">
                                    @if (_buyingId == c.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                    }
                                    Buy
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MarketplaceCardDto> _cards = new();
    private string _search = string.Empty;
    private bool _includeSold;
    private bool _loading = true;
    private int? _buyingId;
    private string? _error;

    private List<MarketplaceCardDto> Filtered => _cards
        .Where(c => string.IsNullOrWhiteSpace(_search)
                 || c.PlayerName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || c.CardNumber.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _cards = await Api.GetMarketplaceAsync(includeSold: _includeSold);
        }
        catch
        {
            _error = "Could not load the marketplace. Please try again.";
        }
        _loading = false;
    }

    private async Task BuyAsync(MarketplaceCardDto card)
    {
        _buyingId = card.Id;
        _error = null;

        var result = await Api.StartCheckoutAsync(card.Id);

        _buyingId = null;
        if (!result.Ok || result.Value is null)
        {
            _error = result.Error ?? "Could not start checkout.";
            return;
        }

        // Redirect the browser to the Stripe-hosted checkout page.
        Nav.NavigateTo(result.Value.Url, forceLoad: true);
    }
}
