@page "/marketplace"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@L["Marketplace — Mark’s Baseball Cards"]</PageTitle>
<section class="page-intro container-width"><p class="eyebrow">@L["Find your next keeper"]</p><div class="page-title-row"><h1>@L["The"] <em>@L["marketplace."]</em></h1><span class="edition-label"><Icon Name="lock" Size="18" /> @L["CHECKOUT"]<br />@L["WITH STRIPE"]</span></div><p>@L["A place for the cards ready for a new home. Explore live listings, read the details, and make your next find."]</p></section>
<section class="container-width collection-content">
    <div class="browse-toolbar"><div class="search-field"><Icon Name="search" /><input type="search" aria-label="@(L["Search marketplace by player or card number"])" placeholder="@(L["Find a player or card number..."])" @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" /></div><div class="toolbar-right"><label class="checkbox-label"><input type="checkbox" @bind="_includeSold" @bind:after="LoadAsync" disabled="@_loading" /> @L["Include sold"]</label><label for="market-sort" class="sr-only">@L["Sort listings"]</label><select id="market-sort" @bind="_sort"><option value="number">@L["Card number"]</option><option value="price-low">@L["Price: low to high"]</option><option value="price-high">@L["Price: high to low"]</option><option value="name">@L["Player A–Z"]</option></select><button class="icon-button" aria-label="@(L["Refresh listings"])" @onclick="LoadAsync" disabled="@_loading"><Icon Name="refresh" /></button></div></div>
    <div class="browse-subbar"><div class="filter-chips" aria-label="@(L["Listing category"])">@foreach (var filter in _filters) { var value = filter; <button class="filter-chip @(_filter == value ? "selected" : "")" aria-pressed="@(_filter == value)" @onclick="() => _filter = value">@L[value]</button> }</div><span class="results-count" role="status">@(_loading ? L["Checking availability..."] : _loadFailed ? L["Availability unavailable"] : L.Format("{0} listings", Filtered.Count))</span></div>
    @if (_checkoutError is not null) { <div class="inline-notice notice-error" role="alert"><Icon Name="info" /><span>@L[_checkoutError]</span><button class="icon-button" aria-label="@(L["Dismiss checkout message"])" @onclick="() => _checkoutError = null"><Icon Name="close" Size="18" /></button></div> }
    @if (_loading)
    {
        <div class="catalog-grid" aria-label="@(L["Loading marketplace"])">@for (var i = 0; i < 4; i++) { <div class="card-skeleton"><div></div><span></span><span></span></div> }</div>
    }
    else if (_loadFailed)
    {
        <div class="empty-state marketplace-unavailable"><span class="state-symbol"><Icon Name="card" Size="30" /></span><p class="eyebrow">@L["A little interruption"]</p><h2>@L["The marketplace is taking a moment."]</h2><p>@L["We couldn’t check live listings right now. You can still explore the original collection while we reconnect."]</p><div class="button-row"><button class="button button-primary" @onclick="LoadAsync">@L["Try again"] <Icon Name="refresh" /></button><a href="collection" class="button button-outline">@L["Explore the archive"] <Icon Name="arrow" /></a></div></div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty-state"><Icon Name="search" Size="32" /><h2>@L[_cards.Count == 0 ? "The next find is still to come." : "No cards match just yet."]</h2><p>@L[_cards.Count == 0 ? "There are no listings to show right now. In the meantime, get to know the original collection." : "Try a different name, number or category."]</p>@if (_cards.Count == 0) { <a class="button button-primary" href="collection">@L["Browse the collection"] <Icon Name="arrow" /></a> } else { <button class="button button-outline" @onclick="ResetFilters">@L["Clear filters"] <Icon Name="arrow" /></button> }</div>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var card in Filtered)
            {
                <article class="listing-card @(card.IsSold ? "is-sold" : "")" @key="card.Id">
                    <button class="card-art-wrap" aria-label="@L.Format("View {0}, card {1}", card.PlayerName, card.CardNumber)" @onclick="() => ShowDetailsAsync(card)"><CardArt Number="@card.CardNumber" PlayerName="@card.PlayerName" /><span class="listing-status @(card.IsSold ? "sold" : "")">@L[card.IsSold ? "Sold" : "Available"]</span><span class="card-open"><Icon Name="eye" /></span></button>
                    <div class="listing-info"><div class="card-meta"><span>1991 TOPPS</span><span>#@card.CardNumber</span></div><h3><button class="plain-button" @onclick="() => ShowDetailsAsync(card)">@card.PlayerName</button></h3><div class="card-tags">@if (card.IsRookie) { <span class="tag tag-rookie">@L["Rookie marker"]</span> } @if (card.IsRoyals) { <span class="tag tag-royals">@L["Royals"]</span> }<span class="tag">@(card.Condition ?? L["Condition not listed"])</span></div><div class="listing-bottom"><span class="listing-price">@L.Usd(card.Price, "Price not listed")<small>USD</small></span><button class="button button-primary button-small" disabled="@(card.IsSold || card.Price.GetValueOrDefault() <= 0 || _buyingId is not null)" @onclick="() => BuyAsync(card)">@L[card.IsSold ? "Sold" : _buyingId == card.Id ? "Opening..." : "Buy card"]<Icon Name="up-right" Size="16" /></button></div></div>
                </article>
            }
        </div>
    }
    <div class="archive-notice"><Icon Name="info" Size="18" /><p>@L["Illustrated record covers, not actual card scans. Condition and notes are supplied by the seller. All displayed prices are in USD."] <a href="about#collection-notes">@L["Collection notes."]</a></p></div>
</section>

<Modal @ref="_modal" Title="@(L["Live marketplace listing"])">
    @if (_selected is not null)
    {
        <div class="detail-grid"><CardArt Number="@_selected.CardNumber" PlayerName="@_selected.PlayerName" /><div class="detail-copy"><p class="eyebrow">@L.Format("1991 Topps / No. {0}", _selected.CardNumber)</p><h2>@_selected.PlayerName</h2><span class="tag">@L[_selected.IsSold ? "Sold" : "Listed for sale"]</span><dl class="detail-facts"><div><dt>@L["Price"]</dt><dd>@L.Usd(_selected.Price) USD</dd></div><div><dt>@L["Condition"]</dt><dd>@(_selected.Condition ?? L["Not specified"])</dd></div><div><dt>@L["Listing notes"]</dt><dd>@(string.IsNullOrWhiteSpace(_selected.ListingNotes) ? L["No additional notes."] : _selected.ListingNotes)</dd></div><div><dt>@L["Image"]</dt><dd>@L["Illustrated cover, not a card scan"]</dd></div></dl><p class="small-note">@L["Review the seller’s details before buying. Card grading, shipping terms and refund terms are not provided by this listing."]</p>@if (_checkoutError is not null) { <p class="form-error" role="alert">@L[_checkoutError]</p> }<button class="button button-primary" disabled="@(_selected.IsSold || _selected.Price.GetValueOrDefault() <= 0 || _buyingId is not null)" @onclick="() => BuyAsync(_selected)">@L[_selected.IsSold ? "Already sold" : _buyingId is not null ? "Opening checkout..." : "Continue to Stripe"] <Icon Name="up-right" /></button></div></div>
    }
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "card")] public string? CardNumber { get; set; }
    private List<MarketplaceCardDto> _cards = [];
    private readonly string[] _filters = ["All cards", "Rookie markers", "Royals"];
    private string _search = "", _filter = "All cards", _sort = "number";
    private string? _exactCard;
    private bool _includeSold, _loading = true, _loadFailed;
    private int? _buyingId;
    private string? _checkoutError;
    private MarketplaceCardDto? _selected;
    private Modal? _modal;
    private List<MarketplaceCardDto> Filtered
    {
        get
        {
            var cards = _cards.Where(c => (string.IsNullOrWhiteSpace(_exactCard) || c.CardNumber.Equals(_exactCard, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_search) || c.PlayerName.Contains(_search, StringComparison.OrdinalIgnoreCase) || c.CardNumber.Contains(_search.TrimStart('#'), StringComparison.OrdinalIgnoreCase)) && (_filter != "Rookie markers" || c.IsRookie) && (_filter != "Royals" || c.IsRoyals));
            return (_sort switch { "name" => cards.OrderBy(c => c.PlayerName), "price-low" => cards.OrderBy(c => c.Price ?? decimal.MaxValue), "price-high" => cards.OrderByDescending(c => c.Price ?? decimal.MinValue), _ => cards.OrderBy(c => int.TryParse(c.CardNumber, out var n) ? n : int.MaxValue).ThenBy(c => c.CardNumber) }).ToList();
        }
    }
    protected override void OnParametersSet() { _exactCard = CardNumber; _search = Search ?? CardNumber ?? ""; }
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        if (_loading && _cards.Count > 0) return;
        _loading = true; _loadFailed = false;
        try { _cards = await Api.GetMarketplaceAsync(includeSold: _includeSold); }
        catch { _loadFailed = true; }
        finally { _loading = false; }
    }
    private void ResetFilters() { _search = ""; _exactCard = null; _filter = "All cards"; }
    private void SearchChanged() => _exactCard = null;
    private async Task ShowDetailsAsync(MarketplaceCardDto card) { _selected = card; _checkoutError = null; StateHasChanged(); if (_modal is not null) await _modal.OpenAsync(); }
    private async Task BuyAsync(MarketplaceCardDto card)
    {
        if (_buyingId is not null || card.IsSold) return;
        _buyingId = card.Id; _checkoutError = null;
        try
        {
            var result = await Api.StartCheckoutAsync(card.Id);
            if (!result.Ok || result.Value is null) { _checkoutError = result.Error ?? "Checkout couldn’t open. Please try again."; return; }
            if (!Uri.TryCreate(result.Value.Url, UriKind.Absolute, out var url) || url.Scheme != "https" || url.Host != "checkout.stripe.com") { _checkoutError = "The checkout address could not be verified. Please try again."; return; }
            Nav.NavigateTo(url.AbsoluteUri, forceLoad: true);
        }
        catch { _checkoutError = "We couldn’t reach checkout. Please try again."; }
        finally { _buyingId = null; }
    }
}
