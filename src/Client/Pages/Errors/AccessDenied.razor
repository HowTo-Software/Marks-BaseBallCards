@page "/access-denied"

<PageTitle>Access denied</PageTitle>

<div class="text-center py-5">
    <div class="display-1 fw-bold text-danger">403</div>
    <h1 class="h3">You don't have access to that</h1>
    <p class="text-muted">
        Your account isn't permitted to view this page. If you believe this is a mistake,
        contact the site owner or sign in with a different account.
    </p>
    <div class="mt-3 d-inline-flex gap-2">
        <a class="btn btn-primary" href="">Home</a>
        <a class="btn btn-outline-secondary" href="login">Switch account</a>
    </div>
</div>
