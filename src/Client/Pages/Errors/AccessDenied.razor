@page "/access-denied"
@inject ClientAuthService Auth
@inject NavigationManager Nav
<PageTitle>@L["Access restricted — Mark’s Baseball Cards"]</PageTitle>
<section class="state-page container-width"><span class="state-symbol"><Icon Name="lock" Size="32" /></span><p class="eyebrow">@L["Staff area"]</p><h1>@L["This one needs"] <em>@L["access."]</em></h1><p>@L["Your current account doesn’t have access to this page. The site owner can help with staff permissions."]</p><div class="button-row"><a class="button button-primary" href="collection">@L["Back to the collection"] <Icon Name="arrow" /></a><button class="button button-outline" @onclick="SwitchAccountAsync">@L["Switch account"]</button></div></section>
@code { private async Task SwitchAccountAsync() { await Auth.LogoutAsync(); Nav.NavigateTo("login"); } }
