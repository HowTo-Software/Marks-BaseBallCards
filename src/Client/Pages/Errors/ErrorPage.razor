@page "/error"

<PageTitle>Something went wrong</PageTitle>

<div class="text-center py-5">
    <div class="display-1">⚠️</div>
    <h1 class="h3">Something went wrong</h1>
    <p class="text-muted">
        An unexpected error occurred. Please try again — if the problem persists, reload the page.
    </p>
    <div class="mt-3 d-inline-flex gap-2">
        <a class="btn btn-primary" href="">Home</a>
        <a class="btn btn-outline-primary" href="marketplace">Marketplace</a>
    </div>
</div>
