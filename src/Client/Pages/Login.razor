@page "/login"
@inject ClientAuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Sign in</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Staff sign in</h1>
                <p class="text-muted small mb-3">Admin and system-operator access only.</p>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2" role="alert">@_error</div>
                }

                <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <InputText id="username" class="form-control" @bind-Value="_model.Username"
                                   autocomplete="username" disabled="@_busy" />
                        <ValidationMessage For="() => _model.Username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password"
                                   autocomplete="current-password" disabled="@_busy" />
                        <ValidationMessage For="() => _model.Password" />
                    </div>
                    <button class="btn btn-primary w-100" type="submit" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Sign in
                    </button>
                </EditForm>

                <p class="text-muted small mt-3 mb-0">
                    <span class="bi" aria-hidden="true">🔒</span>
                    Protected by per-IP rate limiting and automatic account lockout.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginRequest _model = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(DestinationFor(state));
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var (ok, error) = await Auth.LoginAsync(_model);

        _busy = false;
        if (!ok)
        {
            _error = error;
            _model.Password = string.Empty;
            return;
        }

        var state = await AuthState.GetAuthenticationStateAsync();
        Nav.NavigateTo(DestinationFor(state));
    }

    private string DestinationFor(AuthenticationState state)
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return ReturnUrl!;
        }
        if (state.User.IsInRole(Roles.Admin))
        {
            return "admin";
        }
        if (state.User.IsInRole(Roles.SystemAdmin))
        {
            return "system";
        }
        return "";
    }
}
