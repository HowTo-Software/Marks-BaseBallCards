@page "/buy/success"
@implements IDisposable
@inject ApiClient Api

<PageTitle>@L["Payment status — Mark’s Baseball Cards"]</PageTitle>
<section class="state-page container-width">
    @if (_loading)
    {
        <span class="spinner" role="status" aria-label="@(L["Checking payment"])"></span><p class="eyebrow">@L["Back from checkout"]</p><h1>@L["Checking the"] <em>@L["details."]</em></h1><p>@L["We’re checking your payment status with Stripe. This may take a moment."]</p>
    }
    else if (_paid)
    {
        <span class="state-symbol"><Icon Name="check" Size="32" /></span><p class="eyebrow">@L["Payment confirmed"]</p><h1>@L["Thanks for your"] <em>@L["purchase."]</em></h1><p>@L["Your payment has been confirmed by the checkout service."]</p>@if (!string.IsNullOrWhiteSpace(_status?.PlayerName)) { <div class="checkout-summary">#@_status!.CardNumber · @_status.PlayerName</div> }<a class="button button-primary" href="marketplace">@L["Back to the marketplace"] <Icon Name="arrow" /></a>
    }
    else
    {
        <span class="state-symbol"><Icon Name="info" Size="32" /></span><p class="eyebrow">@L["Payment status"]</p><h1>@L["Let’s check"] <em>@L["once more."]</em></h1><p>@L[string.IsNullOrWhiteSpace(SessionId) ? "There’s no checkout reference in this link. Return to the marketplace to begin a purchase." : "We haven’t been able to confirm payment yet. If you completed checkout, allow a moment and check again. This message does not mean your payment failed."]</p><div class="button-row">@if (!string.IsNullOrWhiteSpace(SessionId)) { <button class="button button-primary" @onclick="CheckAsync">@L["Check payment"] <Icon Name="refresh" /></button> }<a class="button button-outline" href="marketplace">@L["Back to the marketplace"] <Icon Name="arrow" /></a></div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "session_id")] public string? SessionId { get; set; }
    private CheckoutStatusDto? _status;
    private bool _loading = true, _paid;
    private CancellationTokenSource? _poll;
    protected override async Task OnParametersSetAsync() => await CheckAsync();
    private async Task CheckAsync()
    {
        _poll?.Cancel(); _poll?.Dispose();
        _poll = new CancellationTokenSource();
        var token = _poll.Token;
        _loading = true; _paid = false;
        try
        {
            if (string.IsNullOrWhiteSpace(SessionId)) return;
            for (var attempt = 0; attempt < 5; attempt++)
            {
                token.ThrowIfCancellationRequested();
                _status = await Api.GetCheckoutStatusAsync(SessionId);
                token.ThrowIfCancellationRequested();
                if (_status?.PaymentStatus == "paid") { _paid = true; break; }
                if (attempt < 4) await Task.Delay(1000, token);
            }
        }
        catch (OperationCanceledException) { }
        catch { _status = null; }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }
    public override void Dispose() { _poll?.Cancel(); _poll?.Dispose(); base.Dispose(); }
}
