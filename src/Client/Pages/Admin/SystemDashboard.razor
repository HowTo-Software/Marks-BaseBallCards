@page "/system"
@attribute [Authorize(Roles = Roles.SystemAdmin)]
@inject ApiClient Api

<PageTitle>System · Statistics</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>System dashboard</h1>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_stats is null)
{
    <div class="alert alert-danger">Could not load statistics.</div>
}
else
{
    <div class="row g-3 my-1">
        @foreach (var tile in Tiles)
        {
            <div class="col-6 col-md-3">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="display-6">@tile.Value</div>
                        <div class="text-muted small">@tile.Label</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="h5 mt-4">Set completion</h2>
    <div class="row g-3">
        @foreach (var s in _stats.SetProgress)
        {
            <div class="col-md-6 col-lg-4">
                <div class="d-flex justify-content-between small">
                    <span>Set #@s.SetNumber</span>
                    <span>@s.CardsFiled / @s.TotalCards (@s.PercentComplete%)</span>
                </div>
                <div class="progress" role="progressbar" aria-valuenow="@s.PercentComplete" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width:@(s.PercentComplete.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h2 class="h5 mb-0">Activity history</h2>
        <small class="text-muted">Generated @_stats.GeneratedAtUtc.ToLocalTime().ToString("g")</small>
    </div>
    @if (_history.Count == 0)
    {
        <p class="text-muted">No activity recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr><th>When</th><th>Action</th><th>Card</th><th>By</th><th>Details</th></tr>
                </thead>
                <tbody>
                    @foreach (var h in _history)
                    {
                        <tr>
                            <td class="text-nowrap small">@h.ChangedAtUtc.ToLocalTime().ToString("g")</td>
                            <td><span class="badge @BadgeFor(h.Action)">@h.Action</span></td>
                            <td class="small">@(string.IsNullOrWhiteSpace(h.CardNumber) ? "" : $"#{h.CardNumber} {h.PlayerName}")</td>
                            <td class="small">@h.ChangedBy</td>
                            <td class="small">@h.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private StatisticsDto? _stats;
    private List<CardHistoryDto> _history = new();
    private bool _loading = true;

    private IEnumerable<(string Label, object Value)> Tiles => _stats is null
        ? Enumerable.Empty<(string, object)>()
        : new (string, object)[]
        {
            ("Total cards", _stats.TotalCards),
            ("In plastic", _stats.CardsInPlastic),
            ("Rookies", _stats.RookieCards),
            ("Royals", _stats.RoyalsCards),
            ("Doubles", _stats.TotalDoubles),
            ("For sale", _stats.CardsForSale),
            ("Sold", _stats.CardsSold),
            ("Sales total", _stats.TotalSalesValue.ToString("C"))
        };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _stats = await Api.GetStatisticsAsync();
            _history = await Api.GetHistoryAsync(200);
        }
        catch
        {
            _stats = null;
        }
        _loading = false;
    }

    private static string BadgeFor(string action) => action switch
    {
        "Created" => "bg-success",
        "Updated" => "bg-primary",
        "Listed" => "bg-success",
        "Unlisted" => "bg-secondary",
        "Sold" => "bg-dark",
        "Deleted" => "bg-danger",
        "Login" => "bg-info text-dark",
        "LoginFailed" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
