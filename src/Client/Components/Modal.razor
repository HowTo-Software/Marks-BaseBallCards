@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="site-dialog" aria-labelledby="@_titleId" @oncancel="HandleCancel" @oncancel:preventDefault="true">
    <div class="dialog-header"><span class="eyebrow" id="@_titleId">@L[Title]</span><button type="button" class="icon-button" aria-label="@(L["Close dialog"])" @onclick="CloseAsync"><Icon Name="close" /></button></div>
    @ChildContent
</dialog>

@code {
    [Parameter] public string Title { get; set; } = "Card details";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private readonly string _titleId = $"dialog-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    public async Task OpenAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
        await _module.InvokeVoidAsync("openDialog", _dialog);
    }
    public async Task CloseAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("closeDialog", _dialog);
        await OnClose.InvokeAsync();
    }
    private Task HandleCancel() => CloseAsync();
    public async ValueTask DisposeAsync()
    {
        base.Dispose();
        if (_module is not null) await _module.DisposeAsync();
    }
}
