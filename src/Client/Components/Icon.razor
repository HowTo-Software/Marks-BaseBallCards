@inherits ComponentBase

<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "sun": <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" /> break;
        case "moon": <path d="M20.8 13A9 9 0 0 1 11 3.2 9 9 0 1 0 20.8 13Z" /> break;
        case "globe": <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c-4 4-4 14 0 18 4-4 4-14 0-18Z" /> break;
        case "arrow": <path d="M4 12h15m-6-6 6 6-6 6" /> break;
        case "up-right": <path d="M6 18 18 6M6 6h12v12" /> break;
        case "search": <circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /> break;
        case "close": <path d="m6 6 12 12M6 18 18 6" /> break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h16" /> break;
        case "grid": <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /> break;
        case "list": <path d="M9 5h12M9 12h12M9 19h12M3 5h1M3 12h1M3 19h1" /> break;
        case "check": <path d="m5 12 4 4L19 6" /> break;
        case "shield": <path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z" /><path d="m8 12 3 3 5-6" /> break;
        case "lock": <rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" /> break;
        case "refresh": <path d="M20 7v5h-5M4 17v-5h5" /><path d="M5.5 7a7.5 7.5 0 0 1 13-.5L20 12M4 12l1.5 5.5a7.5 7.5 0 0 0 13-.5" /> break;
        case "plus": <path d="M12 4v16M4 12h16" /> break;
        case "edit": <path d="m15 4 5 5M4 20l5-1L20 8a2 2 0 0 0-4-4L5 15l-1 5Z" /> break;
        case "eye": <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /> break;
        case "chevron": <path d="m8 10 4 4 4-4" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10v.1" /> break;
        case "card": <rect x="5" y="2" width="14" height="20" rx="2" /><path d="M8 6h8M8 18h8" /><circle cx="12" cy="12" r="3" /> break;
        case "baseball": <circle cx="12" cy="12" r="9" /><path d="M5 5c7 3 7 11 0 14M19 5c-7 3-7 11 0 14M7 7l-2 1m3 2-2 1m2 3-2-1m1 4-2-1m12-9 2 1m-3 2 2 1m-2 3 2-1m-1 4 2-1" /> break;
        default: <circle cx="12" cy="12" r="9" /> break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "arrow";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
}
